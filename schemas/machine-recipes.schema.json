{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"MCKudo · граф машинных рецептов",
  "type":"object", "additionalProperties":false,
  "required":["schemaVersion","minecraftVersion","recipes"],
  "properties":{
    "schemaVersion":{"const":1},
    "minecraftVersion":{"type":"string","minLength":1},
    "source":{"type":"string","description":"Название экспортёра или модпака"},
    "recipes":{"type":"array","maxItems":50000,"items":{"$ref":"#/$defs/recipe"}}
  },
  "$defs":{
    "id":{"type":"string","pattern":"^[a-z0-9_.-]+:[a-z0-9_./-]+$"},
    "amount":{"type":"integer","minimum":1,"maximum":1000000,"default":1},
    "resource":{
      "type":"object","additionalProperties":false,"required":["id"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},
        "kind":{"enum":["item","fluid"],"default":"item"},
        "amount":{"$ref":"#/$defs/amount"}
      }
    },
    "resources":{"type":"array","maxItems":128,"items":{"$ref":"#/$defs/resource"}},
    "recipe":{
      "type":"object","additionalProperties":false,"required":["id","machine","outputs"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},"machine":{"$ref":"#/$defs/id"},
        "inputs":{"$ref":"#/$defs/resources"},
        "outputs":{"$ref":"#/$defs/resources","minItems":1},
        "catalysts":{"$ref":"#/$defs/resources"},
        "durationTicks":{"$ref":"#/$defs/amount"},
        "energy":{
          "type":["object","null"],"additionalProperties":false,"required":["unit","amount"],
          "properties":{"unit":{"$ref":"#/$defs/id"},"amount":{"type":"integer","minimum":0,"maximum":1000000}}
        }
      }
    }
  }
}
