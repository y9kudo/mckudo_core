{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCKudo · простой план агента",
  "type": "array",
  "minItems": 1,
  "maxItems": 64,
  "$defs": {
    "count": { "type": "integer", "minimum": 1, "maximum": 4096, "default": 1 },
    "coordinate": { "type": "integer", "minimum": -30000000, "maximum": 30000000 },
    "item": { "type": "string", "pattern": "^(?:[a-z0-9_.-]+:)?[a-z0-9_./-]+$" }
  },
  "items": {
    "oneOf": [
      {
        "type": "object", "additionalProperties": false, "required": ["get"],
        "properties": {
          "get": { "type": "string", "pattern": "^(?:#[a-z0-9_:.-]+|(?:[a-z0-9_.-]+:)?[a-z0-9_./-]+)$", "description": "Ресурс или класс: #logs, #stone, birch_log. Количество — сколько нужно иметь." },
          "count": { "$ref": "#/$defs/count" }
        }
      },
      {
        "type": "object", "additionalProperties": false, "required": ["craft"],
        "properties": {
          "craft": { "$ref": "#/$defs/item", "description": "Получить предмет с подготовкой ингредиентов, инструментов и станций, например stone_pickaxe." },
          "count": { "$ref": "#/$defs/count" }
        }
      },
      {
        "type": "object", "additionalProperties": false, "required": ["go"],
        "properties": {
          "go": { "type": "object", "additionalProperties": false, "required": ["x","y","z"], "properties": { "x": { "$ref": "#/$defs/coordinate" }, "y": { "$ref": "#/$defs/coordinate" }, "z": { "$ref": "#/$defs/coordinate" } }, "description": "Координаты ног в текущем измерении. Путь рассчитывает ядро." },
          "range": { "type": "integer", "minimum": 0, "maximum": 8, "default": 1 },
          "bridge": { "type": "boolean", "default": true, "description": "Разрешить подготовку материалов и строительство моста." },
          "excavate": { "type": "boolean", "default": false, "description": "Разрешить расчистку обычного грунта с учётом защиты построек." }
        }
      }
    ]
  }
}
