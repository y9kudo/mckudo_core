{
  "name": "overmindmc",
  "version": "1.0.0-Arthas-dev.3",
  "description": "Minecraft Java agent platform with visual programs, 3D debugging, resource planning and independent OMConnect execution",
  "author": "y9kudo",
  "license": "MIT",
  "type": "module",
  "main": "./overmindmc.js",
  "types": "./overmindmc.d.ts",
  "bin": {
    "overmindmc": "./src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./overmindmc.d.ts",
      "import": "./overmindmc.js"
    },
    "./adapters/mineflayer": {
      "types": "./adapters/mineflayer.d.ts",
      "import": "./adapters/mineflayer.js"
    },
    "./connect": {
      "types": "./omconnect/index.d.ts",
      "import": "./omconnect/index.js"
    },
    "./adapters/omconnect": {
      "types": "./adapters/omconnect.d.ts",
      "import": "./adapters/omconnect.js"
    },
    "./adapters/bridge": "./adapters/bridge.js",
    "./adapters/simulator": "./adapters/simulator.js",
    "./memory": "./src/file-memory.js",
    "./schema": "./schemas/agent.schema.json",
    "./adapters/catalog-simulator": "./adapters/catalog-simulator.js",
    "./vectorize": {
      "types": "./packages/omconnect/src/vectorize.d.ts",
      "import": "./packages/omconnect/src/vectorize.js"
    },
    "./intelligence": {
      "types": "./src/intelligence.d.ts",
      "import": "./src/intelligence.js"
    },
    "./native": {
      "types": "./native/index.d.ts",
      "import": "./native/index.js"
    }
  },
  "files": [
    "overmindmc.js",
    "overmindmc.d.ts",
    "src/",
    "native/",
    "scripts/build-native.js",
    "scripts/prepare-version-lab.js",
    "omconnect/",
    "packages/omconnect/",
    "adapters/",
    "schemas/",
    "examples/",
    "docs/",
    "README.md",
    "ROADMAP.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE",
    "mckudo_core.js",
    "mckudo_core.d.ts",
    "scripts/profile-expedition.js",
    "scripts/build-native-tcc.py"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "native:build": "node scripts/build-native.js",
    "test:native": "node --test test/native-kernel.test.js",
    "benchmark:native": "node examples/native-benchmark.js",
    "expedition:full": "node examples/from-zero-to-dragon.js",
    "expedition:check": "node examples/from-zero-to-dragon.js --check",
    "expedition:status": "node examples/expedition-status.js",
    "expedition:profile": "node scripts/profile-expedition.js",
    "release:check": "node scripts/release-check.js",
    "test:package": "node scripts/package-smoke.js",
    "demo:mission": "node examples/mission.js",
    "demo:evidence": "node examples/evidence-memory.js",
    "test:types": "tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 test/types/daily.mts test/types/platform07.mts test/types/evidence.mts test/types/nether.mts test/types/intelligence.mts test/types/physical.mts test/types/native.mts test/types/dev3.mts",
    "test:live:mission": "node examples/mission-live.js",
    "mission:check": "node examples/mission.js examples/missions/first-tools.json --check",
    "test:live:protection": "node examples/protection-live.js",
    "test:cpu": "node examples/cpu-responsiveness.js",
    "test:live:timing": "node examples/timing-live.js",
    "test:runtime": "node examples/runtime-responsiveness.js",
    "test:live:agent": "node examples/agent-live.js",
    "test": "node --test --test-concurrency=4 test/*.test.js packages/omconnect/test/*.test.js",
    "demo": "node examples/demo.js",
    "demo:workflow": "node examples/workflow.js",
    "demo:plugins": "node examples/plugin.js",
    "demo:runtime": "node examples/runtime.js",
    "cli": "node src/cli.js",
    "validate": "node scripts/validate.js",
    "check": "npm run validate && npm test",
    "prepublishOnly": "node scripts/publication-check.js",
    "demo:brain": "node examples/brain.js",
    "demo:brain:mineflayer": "node examples/brain-mineflayer.js",
    "demo:library": "node examples/library-04.js",
    "demo:navigation": "node examples/navigation.js",
    "demo:resources:mineflayer": "node examples/resources-mineflayer.js",
    "demo:scenario": "node examples/scenario-mineflayer.js",
    "test:live:campaign": "node examples/scenario-mineflayer.js examples/scenarios/survival-to-dragon.json",
    "demo:kudoconnect": "node examples/kudoconnect-live.js",
    "dashboard": "node examples/dashboard.js",
    "test:live:native": "node examples/native-campaign.js",
    "test:live:environment": "node examples/environment-probe.js",
    "test:live:daily": "node examples/daily-live.js",
    "test:live:end": "node examples/end-expedition.js",
    "test:live:fall": "node examples/fall-live.js",
    "test:end:check": "node examples/end-expedition.js --check",
    "test:live:dragon": "node examples/dragon-expedition.js",
    "test:dragon:check": "node examples/dragon-expedition.js --check",
    "test:live:pillar": "node examples/pillar-live.js",
    "test:live:learning": "node examples/learning-live.js",
    "test:live:recipes": "node examples/recipes-live.js",
    "test:live:fleet-learning": "node examples/fleet-learning-live.js",
    "test:live:07": "node examples/v07-live.js",
    "demo:machines": "node examples/machines.js",
    "benchmark:diamonds:prepare": "node scripts/prepare-diamond-race.js",
    "benchmark:diamonds:check": "node examples/diamond-race.js --check",
    "benchmark:diamonds": "node examples/diamond-race.js",
    "benchmark:diamonds:status": "node examples/benchmark/status.js",
    "test:live:race-fixes": "node examples/benchmark/bugfix-probe.js",
    "test:live:flight-storage:survey": "node examples/flight-storage-live.js survey",
    "test:live:flight": "node examples/flight-storage-live.js flight",
    "test:live:storage": "node examples/flight-storage-live.js storage",
    "test:live:creative": "node examples/creative-flat-trial.js",
    "test:live:creative:flight": "node examples/creative-flight-live.js",
    "test:live:creative:schematic": "node examples/creative-schematic-build.js",
    "test:live:cooperative-diamonds": "node examples/cooperative-diamonds-live.js",
    "test:cooperative-diamonds:check": "node examples/cooperative-diamonds-live.js --check",
    "dashboard:creative": "node examples/creative-dashboard.js",
    "train:local": "node examples/train-local.js",
    "test:v1": "node --test test/v1-*.test.js test/arthas-*.test.js",
    "benchmark:decisions": "node examples/decision-speed.js",
    "test:live:curriculum": "node examples/curriculum-live.js",
    "train:curriculum": "node examples/train-curriculum.js",
    "train:physical": "node examples/train-physical.js",
    "test:live:rl": "node examples/rl-connect-live.js",
    "check:english": "node scripts/check-english.js",
    "test:live:nether": "node examples/nether-from-zero.js",
    "test:nether:check": "node examples/nether-from-zero.js --check"
  },
  "dependencies": {
    "minecraft-data": "^3.117.0",
    "minecraft-protocol": "^1.68.0",
    "prismarine-block": "^1.23.0",
    "prismarine-chunk": "^1.41.0",
    "prismarine-nbt": "^2.8.0",
    "protodef": "^1.19.0",
    "three": "^0.186.1",
    "vec3": "^0.1.3"
  },
  "devDependencies": {
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/y9kudo/mckudo_core.git"
  },
  "homepage": "https://github.com/y9kudo/mckudo_core#readme",
  "bugs": {
    "url": "https://github.com/y9kudo/mckudo_core/issues"
  },
  "keywords": [
    "minecraft",
    "minecraft-java",
    "ai-agents",
    "agent-framework",
    "automation",
    "visual-programming",
    "pathfinding",
    "reinforcement-learning",
    "omconnect",
    "javascript",
    "typescript"
  ]
}
